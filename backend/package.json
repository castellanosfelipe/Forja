{
  "name": "forja-web-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "@simplewebauthn/server": "13.3.2",
    "@upstash/qstash": "2.11.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/web-push": "3.6.4",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
