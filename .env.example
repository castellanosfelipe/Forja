# Public binding. Keep 127.0.0.1 when another HTTPS proxy terminates TLS.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# WebAuthn values. Production must use the exact HTTPS origin and its hostname.
RP_ID=localhost
RP_NAME=FORJA
EXPECTED_ORIGIN=http://localhost:8080

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000
AUTH_FLOW_TTL_SECONDS=300

# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
