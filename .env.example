# Public binding. Keep 127.0.0.1 when another HTTPS proxy terminates TLS.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
FORJA_DATA_DIR=./data

# WebAuthn values. Production must use the exact HTTPS origin and its hostname.
RP_ID=localhost
RP_NAME=FORJA
EXPECTED_ORIGIN=http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=2592000
AUTH_FLOW_TTL_SECONDS=300

# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Vercel + Neon. Leave these empty for the local Docker/JSON setup.
# DATABASE_URL is supplied by the Neon integration in Vercel.
DATABASE_URL=
# Create QStash credentials at console.upstash.com; all three are required in production.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Vercel authenticates its daily cron with this value. Use at least 16 random characters.
CRON_SECRET=
